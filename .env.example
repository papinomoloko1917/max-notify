# Имена контейнеров Docker. Обычно менять не нужно.
NGINX_CONTAINER_NAME=nginx_app
PHP_CONTAINER_NAME=php_fpm
MYSQL_CONTAINER_NAME=mysql_db
PHPMYADMIN_CONTAINER_NAME=phpmyadmin

# Порты на хосте. Nginx слушает 80, чтобы Dahua могла обращаться по http://server-ip/webhook.
NGINX_PORT=80
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080

# Доступ к MySQL. Сейчас webhook не использует БД, но сервисы оставлены для будущего развития.
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=change_me

MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me

# Токен бота MAX.
# Его выдает платформа MAX при создании бота.
MAX_BOT_TOKEN=change_me

# Несколько камер или каналов NVR.
# Source - техническое имя латиницей, которое передается в webhook: source=gate
# Если source из webhook не найден в CAMERA_SOURCES, событие будет пропущено.

# CAMERA_SOURCES=gate,yard

# Настройки камеры gate.
# LABEL - русское название для сообщения клиенту.
# URL - ссылка на snapshot Dahua/NVR.
# USER/PASSWORD - пользователь Dahua с доступом к snapshot.
# CAMERA_<SOURCE>_MAX_CHAT_ID - один получатель в MAX для этой камеры.
# CAMERA_<SOURCE>_MAX_CHAT_IDS - несколько получателей через запятую. Если задано, имеет приоритет над CAMERA_<SOURCE>_MAX_CHAT_ID.
# В production у каждой камеры должен быть свой CAMERA_<SOURCE>_MAX_CHAT_ID или CAMERA_<SOURCE>_MAX_CHAT_IDS.
# ALLOWED_RULES - какие правила отправлять в MAX. Если пусто, разрешены все.
# Примеры: vehicle_detection или human_detection,vehicle_detection
# CAMERA_GATE_LABEL=Ворота
# CAMERA_GATE_URL=http://camera-ip/cgi-bin/snapshot.cgi?channel=1
# CAMERA_GATE_USER=change_me
# CAMERA_GATE_PASSWORD=change_me
# CAMERA_GATE_MAX_CHAT_ID=
# CAMERA_GATE_MAX_CHAT_IDS=
# CAMERA_GATE_ALLOWED_RULES=

# Настройки камеры yard.
# CAMERA_YARD_LABEL=Двор
# CAMERA_YARD_URL=http://camera-ip/cgi-bin/snapshot.cgi?channel=1
# CAMERA_YARD_USER=change_me
# CAMERA_YARD_PASSWORD=change_me
# CAMERA_YARD_MAX_CHAT_ID=
# CAMERA_YARD_MAX_CHAT_IDS=
# CAMERA_YARD_ALLOWED_RULES=

# Секрет webhook.
# Его нужно добавить в URL Dahua: /webhook?secret=...&event=ivs&source=gate&rule=line_crossing
WEBHOOK_SECRET=change_me

# Защита от дублей.
# Если одинаковое событие event:source:rule пришло повторно в течение этого времени, оно не отправится в MAX.
DUPLICATE_TTL_SECONDS=5

# Временной фильтр отправки уведомлений по Москве.
# Если обе переменные пустые, уведомления отправляются в любое время.
# Пример дневного окна: 08:00 -> 23:00
# Пример ночного окна через полночь: 22:00 -> 07:00
NOTIFY_ALLOWED_FROM=
NOTIFY_ALLOWED_TO=
